{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.thornberrycreekcommunity.com" }],
      "destination": "https://thornberrycreekcommunity.com/$1",
      "permanent": true
    },
    { "source": "/about.html", "destination": "/about-us", "permanent": true },
    { "source": "/contacts.html", "destination": "/important-contacts", "permanent": true },
    { "source": "/contact.html", "destination": "/important-contacts", "permanent": true },
    { "source": "/gallery.html", "destination": "/photo-gallery", "permanent": true },
    { "source": "/news.html", "destination": "/events", "permanent": true },
    { "source": "/index-v1.html", "destination": "/", "permanent": true },
    { "source": "/about", "destination": "/about-us", "permanent": true },
    { "source": "/contacts", "destination": "/important-contacts", "permanent": true },
    { "source": "/photos", "destination": "/photo-gallery", "permanent": true },
    { "source": "/gallery", "destination": "/photo-gallery", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        {
          "key": "Permissions-Policy",
          "value": "accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=(), xr-spatial-tracking=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; manifest-src 'self'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
