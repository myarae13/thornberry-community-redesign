{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/about.html", "destination": "/about-us.html", "permanent": true },
    { "source": "/contacts.html", "destination": "/important-contacts.html", "permanent": true },
    { "source": "/contact.html", "destination": "/important-contacts.html", "permanent": true },
    { "source": "/gallery.html", "destination": "/photo-gallery.html", "permanent": true },
    { "source": "/news.html", "destination": "/events.html", "permanent": true },
    { "source": "/index-v1.html", "destination": "/", "permanent": true },
    { "source": "/about", "destination": "/about-us.html", "permanent": true },
    { "source": "/about-us", "destination": "/about-us.html", "permanent": true },
    { "source": "/events", "destination": "/events.html", "permanent": true },
    { "source": "/contacts", "destination": "/important-contacts.html", "permanent": true },
    { "source": "/important-contacts", "destination": "/important-contacts.html", "permanent": true },
    { "source": "/photos", "destination": "/photo-gallery.html", "permanent": true },
    { "source": "/photo-gallery", "destination": "/photo-gallery.html", "permanent": true },
    { "source": "/gallery", "destination": "/photo-gallery.html", "permanent": true },
    { "source": "/guiding-principles", "destination": "/guiding-principles.html", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    }
  ]
}
